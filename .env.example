# Bu dosyayı .env olarak kopyalayıp düzenleyin:  copy .env.example .env

# --- Django ---
DJANGO_SECRET_KEY=buraya-uzun-rastgele-bir-anahtar-yazin
DJANGO_DEBUG=true
# Başka cihazlardan erişim için bilgisayarın IP adresini ekleyin, ör. localhost,127.0.0.1,192.168.1.20
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# HTTPS/proxy arkasında: https://altyazi.ornek.edu.tr
DJANGO_CSRF_TRUSTED_ORIGINS=

# Boşsa bellek içi kanal katmanı (tek süreç). Üretimde: redis://127.0.0.1:6379/0
REDIS_URL=

# --- Konuşma tanıma (faster-whisper) ---
# tiny | base | small | medium | large-v3 | turbo ...  (CPU için small + int8 önerilir)
ASR_MODEL_SIZE=small
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8
# 0 = otomatik
ASR_CPU_THREADS=0
# Boşsa Hugging Face önbelleği (~/.cache/huggingface). Proje içinde tutmak için: models/whisper
ASR_MODEL_DIR=
ASR_BEAM_SIZE=5

# Kısmi (gri) altyazı: konuşma sürerken ara sonuçlar. Zayıf CPU'da false yapın.
ASR_PARTIALS=true
# Kısmi transkripsiyon aralığı (saniye)
ASR_PARTIAL_INTERVAL=1.2
# Kısmi metin için daha hafif model. CPU'da kesin metni geciktirmemesi için base önerilir; boşsa ana model.
ASR_PARTIAL_MODEL_SIZE=base

# --- Bölümleme / Silero VAD ---
ASR_MAX_SEGMENT_SECONDS=10
ASR_MIN_SILENCE_MS=600
ASR_MIN_SPEECH_MS=250
ASR_SPEECH_PAD_MS=200
ASR_VAD_THRESHOLD=0.5
# Boşsa faster-whisper içindeki model, o da uymazsa resmi Silero modeli (models/ altına indirilir)
ASR_VAD_MODEL_PATH=
ASR_PROMPT_MAX_CHARS=600
# Önceki cümleyi de Whisper istemine ekle (varsayılan kapalı; benzer cümlelerin atlanmasına yol açabiliyor)
ASR_PROMPT_PREVIOUS=false

# --- Terim eşleme ---
TERM_FUZZY_THRESHOLD=88
TERM_FUZZY_MIN_LENGTH=5
TERM_USE_ZEYREK=true
